#!/bin/sh
# Build and load vc4mon for the running kernel.  Never fail the dpkg run: a
# missing compiler or header package must leave vc4top working as root rather
# than leave a half-configured package behind.
set -u

PKG=vc4top
VER=@VERSION@
KVER=$(uname -r)

if ! command -v dkms >/dev/null 2>&1; then
	echo "vc4top-dkms: dkms is not installed; vc4mon was not built." >&2
	echo "vc4top-dkms: install it with: sudo apt install dkms" >&2
	echo "vc4top-dkms: vc4top itself is unaffected and still works as root." >&2
	exit 0
fi

if [ ! -f "/lib/modules/$KVER/build/Makefile" ]; then
	echo "vc4top-dkms: kernel headers for $KVER are not installed; vc4mon was not built." >&2
	echo "vc4top-dkms: vc4top still works as root through /dev/mem; only the" >&2
	echo "vc4top-dkms: unprivileged /sys/kernel/vc4mon/ path needs the module." >&2
	echo "vc4top-dkms: install the headers and retry with:" >&2
	echo "vc4top-dkms:   sudo apt install linux-headers-$KVER" >&2
	echo "vc4top-dkms:   sudo dpkg-reconfigure vc4top-dkms" >&2
	exit 0
fi

# Register the source tree with DKMS.  Already being registered is not an
# error (reinstall, reconfigure, upgrade).
if ! dkms status -m "$PKG" -v "$VER" 2>/dev/null | grep -q .; then
	dkms add -m "$PKG" -v "$VER" || true
fi

if ! dkms build -m "$PKG" -v "$VER" -k "$KVER"; then
	echo "vc4top-dkms: building vc4mon for $KVER failed; vc4top itself is unaffected." >&2
	echo "vc4top-dkms: install build-essential and the kernel headers, then run:" >&2
	echo "vc4top-dkms:   sudo dkms autoinstall -k $KVER" >&2
	echo "vc4top-dkms: or re-run: sudo dpkg-reconfigure vc4top-dkms" >&2
	exit 0
fi

if ! dkms install -m "$PKG" -v "$VER" -k "$KVER" --force; then
	echo "vc4top-dkms: installing the built vc4mon module failed; vc4top itself is unaffected." >&2
	echo "vc4top-dkms: retry with: sudo dkms autoinstall -k $KVER" >&2
	exit 0
fi

depmod -a "$KVER" || true

if modprobe vc4mon 2>/dev/null; then
	echo "vc4top-dkms: vc4mon loaded; unprivileged register reads use /sys/kernel/vc4mon/"
	# udev also does this on module load; run it here so permissions are
	# correct immediately even if udev has not processed the module event.
	/usr/lib/vc4top/vc4mon-permissions 2>/dev/null || true
else
	echo "vc4top-dkms: vc4mon was built but cannot be loaded now;" >&2
	echo "vc4top-dkms: it will load on the next boot (modules-load.d/vc4mon.conf)." >&2
fi

exit 0
